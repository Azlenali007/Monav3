# ==============================================================================
# Mona SMM Panel v2 - Production Nginx Configuration Example
# Place this inside your server { ... } block
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com;
    root /var/www/monav2;

    # Prioritize index.php over index.html
    index index.php index.html;

    charset utf-8;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Standard routing
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Clean API v2 URL rewrite
    location = /api/v2 {
        rewrite ^ /api/v2.php last;
    }

    # Pass PHP scripts to FastCGI server (PHP-FPM)
    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock; # Adjust for your PHP-FPM socket or 127.0.0.1:9000
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_read_timeout 300;
        fastcgi_intercept_errors off;
        fastcgi_buffer_size 16k;
        fastcgi_buffers 4 16k;
    }

    # DENY access to sensitive directories
    location ~ ^/(database|includes|cron)/ {
        deny all;
        return 404;
    }

    # DENY access to sensitive files and extensions
    location ~ \.(sql|env|lock|json|log|sh|py|md|ts|tsx)$ {
        deny all;
        return 404;
    }

    # DENY access to hidden files (.git, .env, etc.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Static assets caching
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}
